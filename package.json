{
  "name": "oh-my-pi-extensions",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "keywords": ["pi-package"],
  "scripts": {
    "postinstall": "node scripts/bootstrap.mjs",
    "pretest": "node scripts/pi-versions.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:compat": "node scripts/pi-compat.mjs",
    "test:install": "node scripts/verify-install.mjs"
  },
  "dependencies": {
    "@amaster.ai/pi-computer-use": "^0.1.22"
  },
  "pi": {
    "skills": ["./browser/skills", "./pi-gui/node_modules/@mirsella/opencode-computer-use-mcp/skills", "./pi-workbench/skills"],
    "extensions": [
      "./orche/src/extension/index.ts",
      "./browser/src/extension/index.ts",
      "./extensions/computer-use/index.js",
      "./pi-gui/src/index.ts",
      "./pi-commit/src/index.ts",
      "./session-bus/src/index.ts",
      "./images/src/index.ts",
      "./pi-workbench/index.js",
      "./codegraph/src/index.ts",
      "./cliproxyapi/src/index.ts",
      "./extensions/dependencies/index.js"
    ]
  }
}
